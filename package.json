{
  "name": "aifar-deployment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "postinstall": "node scripts/setup-dev.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-web.mjs && node scripts/build-backend.mjs",
    "test": "node scripts/test.mjs",
    "db:inspect": "node scripts/admin.mjs inspect",
    "admin:reset": "node scripts/admin.mjs reset-admin",
    "web:dev": "node scripts/run-web.mjs",
    "web:build": "node scripts/build-web.mjs",
    "backend:dev": "node scripts/run-backend.mjs",
    "backend:test": "node scripts/test.mjs",
    "backend:build": "node scripts/build-backend.mjs"
  }
}
