{
  "name": "aifar-deployment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "postinstall": "node scripts/setup-dev.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-web.mjs && node scripts/build-backend.mjs",
    "package": "node scripts/package-build.mjs",
    "release": "node scripts/package-release.mjs",
    "test": "node scripts/test.mjs",
    "test:web": "node scripts/test-web.mjs",
    "test:scripts": "node scripts/test-scripts.mjs",
    "test:tools": "node tools/test-tools.mjs",
    "test:local": "node scripts/test-local.mjs",
    "test:server:readonly": "node scripts/test-server-readonly.mjs",
    "test:e2e:mutating": "node scripts/test-e2e-mutating.mjs",
    "test:all": "node scripts/test-all.mjs",
    "release:verify": "node scripts/verify-release-checksums.mjs",
    "db:inspect": "node scripts/admin.mjs inspect",
    "admin:reset": "node scripts/admin.mjs reset-admin",
    "web:dev": "node scripts/run-web.mjs",
    "web:build": "node scripts/build-web.mjs",
    "backend:dev": "node scripts/run-backend.mjs",
    "backend:test": "node scripts/test.mjs",
    "backend:build": "node scripts/build-backend.mjs"
  }
}
