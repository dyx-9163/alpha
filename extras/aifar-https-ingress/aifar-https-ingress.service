[Unit]
Description=AIFAR HTTPS ingress container
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@@MODULE_DIR@@
ExecStart=@@MODULE_DIR@@/start.sh
ExecStop=@@MODULE_DIR@@/stop.sh
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
