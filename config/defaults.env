# AIFAR default bootstrap credential used by local scripts.
# Change this value before packaging production builds.
AIFAR_DEFAULT_PASSWORD=Oversea.123

# HTTP listen address used by production startup scripts.
AIFAR_ADDR=0.0.0.0:8080

# Local development listen settings. Keep loopback-only by default to avoid
# Windows Firewall prompts and accidental LAN exposure during development.
AIFAR_DEV_ADDR=127.0.0.1:8080
AIFAR_VITE_HOST=127.0.0.1

# Secret used to encrypt saved SSH and object-storage credentials.
# Set a stable high-entropy value before first production start.
AIFAR_CREDENTIAL_SECRET=change-me-before-production

# Authentication brute-force protection.
# After this many failed login attempts from the same account and source,
# the login endpoint is temporarily locked for AIFAR_AUTH_LOCKOUT_SECONDS.
AIFAR_AUTH_MAX_FAILURES=5
AIFAR_AUTH_LOCKOUT_SECONDS=300

# Maximum HTTP request body accepted by JSON APIs. Default: 1 MiB.
AIFAR_MAX_REQUEST_BODY_BYTES=1048576

# Control-plane retention policy. Manual cleanup removes audit records and
# finished task records older than these windows.
AIFAR_AUDIT_RETENTION_DAYS=180
AIFAR_TASK_RETENTION_DAYS=90

# Default remote working directory for server-side app deployment files.
AIFAR_DEFAULT_DEPLOY_DIR=/aifar/apps
