# AIFAR default bootstrap credential used by local scripts.
# Change this value before packaging production builds.
AIFAR_DEFAULT_PASSWORD=Oversea.123

# Secret used to encrypt saved SSH and object-storage credentials.
# Set a stable high-entropy value before first production start.
AIFAR_CREDENTIAL_SECRET=change-me-before-production

# Default remote working directory for server-side app deployment files.
AIFAR_DEFAULT_DEPLOY_DIR=/aifar/apps
