# AIFAR default environment
# AIFAR 默认环境变量
#
# zh: 这个文件会被本地开发脚本、构建脚本和生产启动脚本读取。
# en: This file is read by local development scripts, build scripts, and production startup scripts.
#
# zh: 生产环境请在打包前确认安全类变量，不要把真实密码、token 或私钥提交到代码仓库。
# en: For production, review security variables before packaging. Do not commit real passwords, tokens, or private keys.
#
# zh: 应用版本号不要写在这里；版本应来自 resources/<app>/<version> 目录扫描结果。
# en: Do not define application versions here. Versions should come from resources/<app>/<version> scanning.


# -----------------------------------------------------------------------------
# 1. Control-plane service / 控制面服务
# -----------------------------------------------------------------------------

# zh: 生产 HTTP 监听地址。
# en: Production HTTP listen address.
AIFAR_ADDR=0.0.0.0:8080

# zh: 前端静态资源目录。生产包通常使用 web/dist。
# en: Frontend static assets directory. Production packages usually use web/dist.
AIFAR_STATIC_DIR=web/dist

# zh: 离线资源根目录。应用版本从该目录结构自动发现。
# en: Offline resource root. Application versions are discovered from this directory structure.
AIFAR_RESOURCE_DIR=resources

# zh: SQLite 数据库路径。
# en: SQLite database path.
AIFAR_DATABASE_PATH=data/aifar.db


# -----------------------------------------------------------------------------
# 2. Local development / 本地开发
# -----------------------------------------------------------------------------

# zh: 本地开发后端监听地址，默认只监听本机，避免误暴露到局域网。
# en: Local development backend listen address. Loopback-only by default to avoid LAN exposure.
AIFAR_DEV_ADDR=127.0.0.1:8080

# zh: Vite 开发服务器监听主机。
# en: Vite development server host.
AIFAR_VITE_HOST=127.0.0.1


# -----------------------------------------------------------------------------
# 3. Bootstrap account and security / 初始化账号与安全
# -----------------------------------------------------------------------------

# zh: 面板默认密码。发布包保持留空，部署时通过本地配置或环境变量设置。
# en: Default panel password. Keep release artifacts blank and set it during deployment.
AIFAR_DEFAULT_PASSWORD=

# zh: 初始化管理员账号。
# en: Bootstrap administrator username.
AIFAR_BOOTSTRAP_USERNAME=admin

# zh: 初始化管理员密码；留空时由程序使用 AIFAR_DEFAULT_PASSWORD。
# en: Bootstrap administrator password. When empty, the program uses AIFAR_DEFAULT_PASSWORD.
AIFAR_BOOTSTRAP_PASSWORD=

# zh: JWT 签名密钥。生产环境请设置稳定的高强度随机值。
# en: JWT signing secret. Use a stable high-entropy random value in production.
AIFAR_JWT_SECRET=

# zh: SSH 密码、私钥和对象存储密钥等敏感字段的加密密钥。
# en: Encryption secret for saved SSH passwords, private keys, and object-storage secrets.
AIFAR_CREDENTIAL_SECRET=

# zh: 仅轮换凭据加密密钥时临时设置旧密钥；启动成功后立即清空。
# en: Set the old encryption secret only during key rotation, then clear it after a successful start.
AIFAR_PREVIOUS_CREDENTIAL_SECRET=

# zh: 仅当 AIFAR_ADDR 的主机严格为 127.0.0.1、localhost 或 ::1 时，才可显式放行内置弱配置；生产环境必须保持 false。
# en: Weak built-in defaults may be enabled only when the AIFAR_ADDR host is exactly 127.0.0.1, localhost, or ::1. Keep false in production.
AIFAR_ALLOW_INSECURE_DEFAULTS=false

# zh: 显式允许弱面板密码或内置默认密码；只跳过密码强度检查，不跳过 JWT/凭据加密密钥校验。
# en: Explicitly allow weak or built-in panel passwords. This only skips password checks; JWT and credential secret checks still apply.
AIFAR_ALLOW_WEAK_PASSWORDS=false

# zh: 登录失败锁定策略。
# en: Login failure lockout policy.
AIFAR_AUTH_MAX_FAILURES=5
AIFAR_AUTH_LOCKOUT_SECONDS=300


# -----------------------------------------------------------------------------
# 4. Deployment runtime / 部署运行时
# -----------------------------------------------------------------------------

# zh: 远程服务器默认部署根目录；具体应用安装目录由模块按标准子目录生成。
# en: Default remote deployment root. App modules derive standard child directories from it.
AIFAR_DEFAULT_DEPLOY_DIR=/aifar/apps

# zh: 安装任务并发数；所有多服务器安装任务以这个值为准。
# en: Deployment concurrency. All multi-server install tasks use this value.
AIFAR_DEPLOYMENT_CONCURRENCY=2

# zh: 自动状态采集间隔秒数；用于服务器、Docker 和 AIFAR Runtime 最新状态快照。
# en: Automatic status collection interval in seconds, used for server, Docker, and AIFAR Runtime snapshots.
AIFAR_COLLECTOR_INTERVAL_SECONDS=15

# zh: 安装脚本覆盖模板目录。不存在对应文件时自动使用二进制内置模板。
# en: Installer script override directory. Built-in templates are used when a matching file is absent.
AIFAR_INSTALLER_TEMPLATE_DIR=config/installers


# -----------------------------------------------------------------------------
# 5. API limits / API 限制
# -----------------------------------------------------------------------------

# zh: API 最大请求体大小，包含制品上传，默认 4 GiB。
# en: Maximum API request body size, including artifact uploads. Default is 4 GiB.
AIFAR_MAX_REQUEST_BODY_BYTES=4294967296


# -----------------------------------------------------------------------------
# 6. Maintenance and retention / 维护与保留策略
# -----------------------------------------------------------------------------

# zh: 手动维护备份任务使用的控制面 SQLite 备份目录。
# en: Control-plane SQLite backup directory used by manual maintenance backup tasks.
AIFAR_DATABASE_BACKUP_DIR=data/backups

# zh: MySQL 澶囦唤浠撳簱鐩綍锛岀敓浜ф鏌ュ簲鎸囧悜鐙珛鎸傝浇鐩樻垨 NAS锛屼笉寰楀拰 MySQL 鏁版嵁鐩樺叡鐢ㄣ€?# en: MySQL backup repository. In production, set this to a dedicated mounted disk or NAS, separate from MySQL data.
AIFAR_MYSQL_BACKUP_DIR=data/mysql-backups

# zh: 榛樿淇濈暀鐨勬渶鏂?MySQL 鎴愬姛澶囦唤鏁伴噺銆?# en: Default number of newest successful MySQL backups to retain.
AIFAR_MYSQL_BACKUP_KEEP_LAST=5

# zh: 审计日志保留天数。
# en: Audit log retention days.
AIFAR_AUDIT_RETENTION_DAYS=180

# zh: 已完成任务记录保留天数。
# en: Finished task retention days.
AIFAR_TASK_RETENTION_DAYS=90


# -----------------------------------------------------------------------------
# 7. Toolchain override / 工具链覆盖
# -----------------------------------------------------------------------------

# zh: 本地构建工具根目录；未设置时开发脚本使用 D:\tools。
# en: Local build tool root. Development scripts use D:\tools when unset.
# AIFAR_TOOL_ROOT=D:\tools

# zh: Go 构建缓存目录。
# en: Go build cache directory.
# AIFAR_GO_CACHE=.cache/go-build
